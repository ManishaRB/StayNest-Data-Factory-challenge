{
	"name": "AzureSQLToADLS",
	"properties": {
		"activities": [
			{
				"name": "AzureSQLToADLS",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "AzureSQL_Employee",
						"type": "DatasetReference",
						"parameters": {
							"p_schema_nm": "dbo",
							"p_table_nm": "employee"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_Employee_tgt_Storage",
						"type": "DatasetReference",
						"parameters": {
							"p_Filesystem": "learnit",
							"p_Directory": "target",
							"p_Filename": "Employee_AzureSQL_New"
						}
					}
				]
			}
		],
		"folder": {
			"name": "Practice"
		},
		"annotations": [],
		"lastPublishTime": "2026-10-01T00:15:19Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}